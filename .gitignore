# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

# --- IDE / editor ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS metadata ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- OpenFOAM / blastFoam run artifacts -----------------------------------
# Local end-to-end test runs (huge mesh / processor* artifacts).
_e2e_runs/
# Timestamped cases generated by the GUI's "Run" button (Case_<dim>_<YYYYMMDD>_<HHMMSS>/).
# Reference cases like building3D/ and mappedBuilding3D/ stay tracked.
Case_1D_[0-9]*/
Case_2D_[0-9]*/
Case_3D_[0-9]*/

# Local validation / AMR / audit case trees (meshes, processor*, time dirs —
# often multi-GB). Keep the scripts that *generate* them under tools/; never
# commit the generated case outputs.
_val_*/
_amr_*/
_audit_*/
_wsl_*/
_wsl_*.log

# OpenFOAM runtime debris at repo root only (do not ignore tutorial 0/ dirs)
/processor*/
/postProcessing/
/log.*
/*.foam
/core
/core.*

# --- Transient files used by the agent / scripts --------------------------
_commit_msg.txt
_inspect_*.sh
_test_*.py
_test_*.txt
_refactor_*.py
*.bak
*.tmp
*.npy
*.gif

# --- Local debug / agent dumps --------------------------------------------
debug_summary.txt
/debug_*.txt
_debug_*.py
_diag_*.py
_live_*.py
_head_*.py
_tail_*.py
/_import_proof_screens/

# Root-level review packaging dumps
/GGUI-*-review*.zip
/GGUI_*_review_upload/

# UI Review overlay output (never commit)
_ui_review/

# Local UFC / DPlot extracts (zip, GRF, inspection scripts). Runtime uses validation/data/*.json.
_ref_src/
